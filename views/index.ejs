<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task Manager</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>

    <div class="main w-full min-h-screen bg-zinc-900">

        <!-- Create Task Form -->
        <div class="form p-10 text-white">

            <h1 class="text-4xl mb-6 font-bold">Task Manager</h1>

            <form action="/create" method="POST">

                <input
                    class="block px-5 rounded-md outline-none w-full py-2 bg-zinc-800"
                    type="text"
                    placeholder="Title goes here"
                    name="title"
                    required>

                <textarea
                    class="block px-5 rounded-md w-full outline-none mt-2 py-2 resize-none bg-zinc-800"
                    placeholder="Write your task details here"
                    name="details"
                    required></textarea>

                <input
                    class="mt-3 bg-blue-600 px-5 py-2 rounded-md cursor-pointer"
                    type="submit"
                    value="Create Task">

            </form>

        </div>

        <!-- Task Cards -->
        <div class="tasks flex gap-4 flex-wrap p-10">

            <% if(files.length > 0) { %>

                <% files.forEach(function(val){ %>

                    <div class="w-72 p-4 rounded-md bg-zinc-800">

                        <h2 class="text-white text-2xl break-words">
                            <%= val %>
                        </h2>

                        <div class="flex items-center gap-4 mt-4">

                            <a
                                class="text-blue-500"
                                href="/file/<%= val %>">
                                Read More
                            </a>

                            <form
                                action="/delete/<%= val %>"
                                method="POST">

                                <button
                                    type="submit"
                                    onclick="return confirm('Delete this task?')"
                                    class="text-red-500">
                                    Delete
                                </button>

                            </form>

                        </div>

                    </div>

                <% }) %>

            <% } else { %>

                <h3 class="text-zinc-500 text-xl">
                    No Tasks Yet
                </h3>

            <% } %>

        </div>

    </div>

</body>

</html>