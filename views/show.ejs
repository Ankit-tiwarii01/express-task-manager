<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task Details</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>

    <div class="w-full min-h-screen bg-zinc-900 p-10 text-white">

        <a
            href="/"
            class="text-blue-500 inline-block mb-10">
            ← Back to Home
        </a>

        <h1 class="text-4xl font-bold break-words">
            <%= filename %>
        </h1>

        <div class="mt-6 p-5 bg-zinc-800 rounded-md">

            <p class="text-lg whitespace-pre-wrap">
                <%= filedata %>
            </p>

        </div>

    </div>

</body>

</html>